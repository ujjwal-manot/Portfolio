# Maps fifo_bridge onto IHP SG13G2 standard cells using the slow corner library (1.08 V, 125 C), with buffering and sizing in ABC.
read_verilog -sv ../design/sync2.sv ../design/reset_sync.sv ../design/async_fifo.sv ../design/skid_buffer.sv ../design/fifo_bridge.sv
synth -flatten -top fifo_bridge
dfflibmap -liberty ../build/slow.lib
abc -D 20000 -liberty ../build/slow.lib -script +strash;dch;map,-B,0.9;topo;stime,-c;buffer,-c;upsize,-c,{D};dnsize,-c,{D};stime,-p
opt_clean -purge
autoname
hilomap -singleton -hicell sg13g2_tiehi L_HI -locell sg13g2_tielo L_LO
stat -liberty ../build/slow.lib
write_verilog -noattr ../build/fifo_bridge_cells.v
