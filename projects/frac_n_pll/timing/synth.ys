# Maps frac_n_pll digital RTL blocks (mash111 and pfd_div) onto IHP SG13G2 standard cells using the slow corner library (1.08 V, 125 C), with buffering and sizing in ABC.
read_verilog -sv ../design/mash111.sv ../design/pfd_div.sv
synth -flatten -top mash111
dfflibmap -liberty ../build/slow.lib
abc -D 20000 -liberty ../build/slow.lib -script +strash;dch;map,-B,0.9;topo;stime,-c;buffer,-c;upsize,-c,{D};dnsize,-c,{D};stime,-p
opt_clean -purge
autoname
rename -unescape t:sg13g2_*
hilomap -singleton -hicell sg13g2_tiehi L_HI -locell sg13g2_tielo L_LO
stat -liberty ../build/slow.lib
write_verilog -noattr ../build/mash111_cells.v
design -reset
read_verilog -sv ../design/pfd_div.sv
synth -flatten -top pfd_div
dfflibmap -liberty ../build/slow.lib
abc -D 20000 -liberty ../build/slow.lib -script +strash;dch;map,-B,0.9;topo;stime,-c;buffer,-c;upsize,-c,{D};dnsize,-c,{D};stime,-p
opt_clean -purge
hilomap -singleton -hicell sg13g2_tiehi L_HI -locell sg13g2_tielo L_LO
write_verilog -noattr ../build/pfd_div_cells.v
