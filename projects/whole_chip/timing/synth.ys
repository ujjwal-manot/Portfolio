# Maps whole_chip_top and its digital sub-blocks (sar_logic, fifo_bridge, cpu, dldo_ctrl) onto IHP SG13G2 standard cells using the slow corner library (1.08 V, 125 C), with buffering and sizing in ABC.
read_verilog -sv ../../fifo_bridge/design/sync2.sv ../../fifo_bridge/design/reset_sync.sv ../../fifo_bridge/design/async_fifo.sv ../../fifo_bridge/design/skid_buffer.sv ../../fifo_bridge/design/fifo_bridge.sv ../../adc/design/sar_logic.sv ../../cpu/design/cpu.sv ../../power_manager/design/dldo_ctrl.sv ../design/whole_chip_top.sv
synth -flatten -top whole_chip_top
dfflibmap -liberty ../build/slow.lib
abc -D 20000 -liberty ../build/slow.lib -script +strash;dch;map,-B,0.9;topo;stime,-c;buffer,-c;upsize,-c,{D};dnsize,-c,{D};stime,-p
opt_clean -purge
autoname
rename -unescape t:sg13g2_*
hilomap -singleton -hicell sg13g2_tiehi L_HI -locell sg13g2_tielo L_LO
stat -liberty ../build/slow.lib
write_verilog -noattr ../build/whole_chip_top_cells.v
