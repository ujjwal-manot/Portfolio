* Converts a coherent -0.5 dBFS sine (bin K of N samples at 1 MS/s, both set in tone.inc) with the transistor capacitor DAC and comparator, clocked by the real sar_logic RTL (Verilator through ngspice d_cosim), and writes time, m_tvalid, the eight m_tdata bits, samp and vin every 50 ns to convert.txt and the average power drawn from the supply and from vref_hi, vref_lo and vcm over the conversions, with the input frequency measured between two rising crossings of vcm, each integrated by the solver at every step into a 1 F capacitor (the transistor parts only; the SAR logic runs as a Verilator model) to measure.txt, solved to a relative tolerance of 1e-5 (the default 1e-3 is 0.6 mV on a 0.6 V node, a fifth of an LSB); corner, temperature, supply and mismatch come from corner.inc; every node has 1e13 ohm to ground, without which the -40 C operating point does not solve (at most 0.6 V / 1e13 ohm for 1 us on the 2 pF array, 0.01 LSB, and shunt_check finds no code changed at 27 C).
.include corner.inc
.option reltol=1e-5 vntol=1e-8
.include tone.inc
.include comparator_sizes.inc
.include cap_dac_sizes.inc
.include comparator.cir
.include cap_dac.cir
.option interp rshunt=1e13
VDD vdd 0 {vsupply}
VHI vref_hi 0 1.0
VLO vref_lo 0 0.2
VCM vcm 0 0.6
VIN vin 0 sin(0.6 {0.4 * 10 ** (-0.5 / 20)} {k_tone * 1e6 / n_samples} 0 0 0)
VCLK clk 0 pulse(0 {vsupply} 50n 50p 50p 49.95n 100n)
VRST rst 0 pwl(0 0 250n 0 251n {vsupply})
VRDY rdy 0 {vsupply}
AIN [clk rst cmp rdy] [dclk drst dcmp drdy] tobits
.model tobits adc_bridge(in_low={vsupply / 3} in_high={2 * vsupply / 3})
ASAR [dclk drst dcmp drdy] [dsamp dcclk d7 d6 d5 d4 d3 d2 d1 d0 dvalid t7 t6 t5 t4 t3 t2 t1 t0 dlast dovf] null sar
.model sar d_cosim simulation="./sar_logic.so"
AOUT [dsamp dcclk d7 d6 d5 d4 d3 d2 d1 d0 dvalid t7 t6 t5 t4 t3 t2 t1 t0] [samp cclk a7 a6 a5 a4 a3 a2 a1 a0 valid b7 b6 b5 b4 b3 b2 b1 b0] tovolts
.model tovolts dac_bridge(out_low=0 out_high={vsupply} t_rise=50p t_fall=50p)
XDAC top vin vcm vref_hi vref_lo samp a7 a6 a5 a4 a3 a2 a1 a0 vdd 0 cap_dac
XCMP vcm top cclk cmp cmpn vdd 0 comparator
BEVDD 0 e_vdd i = time > 0 ? -v(vdd) * i(VDD) : 0
CEVDD e_vdd 0 1
REVDD e_vdd 0 1e12
BEHI 0 e_hi i = time > 0 ? -v(vref_hi) * i(VHI) : 0
CEHI e_hi 0 1
REHI e_hi 0 1e12
BELO 0 e_lo i = time > 0 ? -v(vref_lo) * i(VLO) : 0
CELO e_lo 0 1
RELO e_lo 0 1e12
BECM 0 e_cm i = time > 0 ? -v(vcm) * i(VCM) : 0
CECM e_cm 0 1
RECM e_cm 0 1e12
.tran 50n {(n_samples + 3) * 1u + 300n}
.control
run
let span = length(time) - 1
let window = time[span] - 1.3e-6
meas tran e0 find v(e_vdd) at=1.3u
meas tran h0 find v(e_hi) at=1.3u
meas tran l0 find v(e_lo) at=1.3u
meas tran c0 find v(e_cm) at=1.3u
let p_vdd = (v(e_vdd)[span] - e0) / window
let p_hi = (v(e_hi)[span] - h0) / window
let p_lo = (v(e_lo)[span] - l0) / window
let p_cm = (v(e_cm)[span] - c0) / window
meas tran first when v(vin)=v(vcm) rise=1
meas tran second when v(vin)=v(vcm) rise=2
let fin = 1 / (second - first)
echo "p_vdd_w $&p_vdd p_hi_w $&p_hi p_lo_w $&p_lo p_cm_w $&p_cm fin_hz $&fin" > measure.txt
wrdata convert.txt v(valid) v(b7) v(b6) v(b5) v(b4) v(b3) v(b2) v(b1) v(b0) v(samp) v(vin)
.endc
.end
