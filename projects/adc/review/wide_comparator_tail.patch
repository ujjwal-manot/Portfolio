-.param l_min=0.13u w_tail=0.5u w_in=4u l_in=0.26u ng_in=2 w_nx=1u w_px=1u w_rst=0.5u w_gate_n=0.5u w_gate_p=1u
+.param l_min=0.13u w_tail=4u w_in=4u l_in=0.26u ng_in=2 w_nx=1u w_px=1u w_rst=0.5u w_gate_n=0.5u w_gate_p=1u
