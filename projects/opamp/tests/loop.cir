* Measures the loop gain of the opamp in its real inverting loop (rhigh Rin = Rf = 20 k, MIM 2.05 pF load, input and inp at 0.6 V) by Tian's method, with no loop-breaking parts, and writes DC loop gain, open-loop gain, loop crossover, phase margin, GBW (open-loop gain times frequency at 1 MHz, between the poles) and the open-loop unity-gain frequency to loop.txt; corner, temperature and supply come from corner.inc, the opamp from dut.cir and sizes.inc; every value is written as nan if any measurement or analysis failed (a failed measure leaves its vector undefined, so the sum of the measures times zero cannot be formed).
.include corner.inc
.include sizes.inc
.include dut.cir
VDD vdd 0 {vsupply}
VCM inp 0 0.6
VIN in 0 0.6
IB vdd ibias 10u
XRIN in inn 0 rhigh w={w_rf} l={l_rf} mm_ok={mm}
XRF inn out 0 rhigh w={w_rf} l={l_rf} mm_ok={mm}
XCL out 0 cap_cmim w={w_cl} l={l_cl} mm_ok={mm}
XOP inp inn oa vdd 0 ibias opamp
VI out oa dc 0 ac 1
II 0 out dc 0 ac 0
.control
ac dec 50 1 10g
let ip = i(vi)
let vp = v(out)
alter vi ac = 0
alter ii ac = 1
ac dec 50 1 10g
let points = length(ac2.frequency)
let t = -1/(1-1/(2*(ac1.ip*v(out)-ac1.vp*i(vi))+ac1.vp+i(vi)))
let tdb = db(t)
let tph = 180/pi*cph(t)
meas ac fc when tdb=0
meas ac ugf when tdb=-6.0206
meas ac t1m find tdb at=1e6
meas ac ph find tph at=$&fc
let t0 = tdb[0]
let pm = 180 + ph
let a0 = t0 + 6.0206
let gbw = 1e6 * 10^((t1m + 6.0206) / 20)
let complete = fc*0 + ugf*0 + t1m*0 + ph*0 + points*0
if complete = 0
  echo loop a0_db $&a0 fc_hz $&fc pm_deg $&pm gbw_hz $&gbw ugf_hz $&ugf > loop.txt
else
  echo loop a0_db nan fc_hz nan pm_deg nan gbw_hz nan ugf_hz nan > loop.txt
end
quit
.endc
.end
