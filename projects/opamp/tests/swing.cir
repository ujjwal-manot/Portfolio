* Sweeps the input of the real inverting loop from 0 to 1.2 V and writes the output range over which the output stays within half an LSB (1.5625 mV) of the loop's own straight line (through the mid-scale output, with the slope measured between inputs of 0.25 and 0.95 V, so gain error from resistor mismatch is not counted as clipping), searching each half of the sweep on its own (a range that never leaves the band runs to the end of the sweep), plus the input-referred offset (half the output error at mid-scale, noise gain 2) and the closed-loop gain error (output slope between inputs of 0.25 and 0.95 V, about the -1 dBFS peaks, against the ideal -1), to swing.txt; corner, temperature and supply come from corner.inc, the opamp from dut.cir and sizes.inc.
.include corner.inc
.include sizes.inc
.include dut.cir
VDD vdd 0 {vsupply}
VCM inp 0 0.6
VIN in 0 0.6
IB vdd ibias 10u
XRIN in inn 0 rhigh w={w_rf} l={l_rf} mm_ok={mm}
XRF inn out 0 rhigh w={w_rf} l={l_rf} mm_ok={mm}
XCL out 0 cap_cmim w={w_cl} l={l_cl} mm_ok={mm}
XOP inp inn out vdd 0 ibias opamp
.control
let mid = 0
let lo = 1.2
let hi = 0
let top = 0
let bottom = 0
dc VIN 0 1.2 1m
meas dc mid find v(out) at=0.6
meas dc top find v(out) at=0.25
meas dc bottom find v(out) at=0.95
let slope = (top - bottom) / 0.7
let gain_error = slope - 1
let err = abs(v(out) - mid - slope * (0.6 - v(in)))
meas dc hi when err=1.5625m cross=last from=0 to=0.6
meas dc lo when err=1.5625m cross=1 from=0.6 to=1.2
let out_high = mid + slope * (0.6 - hi)
let out_low = mid + slope * (0.6 - lo)
let offset = (mid - 0.6) / 2
echo swing out_low_v $&out_low out_high_v $&out_high offset_v $&offset gain_error $&gain_error > swing.txt
quit
.endc
.end
